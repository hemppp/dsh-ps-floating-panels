{
  "$schema": "https://deepseek-harness.github.io/deepseek-harness/schema/dsh-plugin-manifest.json",
  "manifestVersion": 1,
  "id": "dsh-ps-floating-panels",
  "name": "dsh-ps-floating-panels",
  "displayName": "PS 浮动面板 / PS Floating Panels",
  "version": "0.2.0",
  "description": "把宿主真实 UI 拆进可浮动/停靠/拆分的 Dockview 面板（仅桌面端）。",
  "license": "MIT",
  "kind": "bundle",
  "platform": "web",
  "host": {
    "entry": "./lib/index.js",
    "types": "./lib/types/index.d.ts",
    "configNamespace": "dsh-ps-floating-panels"
  },
  "client": {
    "entry": "./client/client.js",
    "moduleId": "dsh-ps-floating-panels",
    "format": "lazy-cjs-factory",
    "extensionPoint": "shell.overlay",
    "inject": [
      "@deepseek-ai/dsh-client-ui-layout",
      "@deepseek-ai/dsh-client-ui-theme",
      "@deepseek-ai/dsh-client-locale",
      "@deepseek-ai/dsh-client-ui-settings"
    ],
    "externals": [
      "react",
      "react-dom",
      "react/jsx-runtime"
    ]
  },
  "bundle": {
    "patch": "./cordis.patch.yml",
    "rowId": "dsh-ps-floating-panels"
  },
  "config": {
    "namespace": "dsh-ps-floating-panels",
    "schema": "schemastery",
    "fields": [
      "enabled",
      "nativeAdopt",
      "showLauncher",
      "showStatusBadge",
      "minDesktopWidth",
      "persistDebounceMs",
      "collapsedPanels",
      "autoHideOnHover",
      "layout"
    ]
  },
  "panels": [
    "sidebar",
    "main",
    "rightbar"
  ],
  "targets": ["desktop"]
}
